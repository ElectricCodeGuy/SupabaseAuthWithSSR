# Local vLLM server on the GPU box (Qwen3.8-27B-Uncensored-FP8), OpenAI-compatible base URL
VLLM_BASE_URL=http://192.168.0.29:8000/v1

# Local Qwen-Image-2.1 server for the generateImage tool — OpenAI-compatible
# POST {base}/images/generations returning b64_json. Optional overrides:
# IMAGE_GEN_MODEL (default Qwen/Qwen-Image-2.1), IMAGE_GEN_STEPS (sent as
# num_inference_steps), IMAGE_GEN_TIMEOUT_MS (default 600000)
IMAGE_GEN_BASE_URL=http://localhost:8004/v1
