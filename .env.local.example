# Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=

## https://www.anthropic.com/ — powers the AI chat (Claude) ##
ANTHROPIC_API_KEY=

# Mistral AI for OCR
MISTRAL_API_KEY=

# Voyage API key: https://www.voyageai.com/
VOYAGE_API_KEY=

# EXA API Key: https://exa.ai/ for web search tool
